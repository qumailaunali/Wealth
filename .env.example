# Supabase transaction pooler (port 6543), used by the app at runtime. TLS verified with prisma/supabase-ca.crt
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=prisma/supabase-ca.crt"
# Supabase session pooler (port 5432), used by `prisma migrate`
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&sslcert=prisma/supabase-ca.crt&sslaccept=strict"
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=""
# Public URL of the app (https://your-domain.com in production)
AUTH_URL="http://localhost:3000"
# Trust the Host header (needed behind proxies / on a VPS)
AUTH_TRUST_HOST=true
# Optional: secret for the recurring-transactions cron endpoint (/api/cron/recurring)
CRON_SECRET=""
# Silences the dev-only "Serwist + Turbopack" notice (the SW is only built for production)
SERWIST_SUPPRESS_TURBOPACK_WARNING=1
