# PostgreSQL connection used by the app at runtime (pooled URL is fine, e.g. Neon/Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full"
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=""
# Public URL of the app (https://your-domain.com in production)
AUTH_URL="http://localhost:3000"
# Trust the Host header (needed behind proxies / on a VPS)
AUTH_TRUST_HOST=true
# Optional: secret for the recurring-transactions cron endpoint (/api/cron/recurring)
CRON_SECRET=""
# Silences the dev-only "Serwist + Turbopack" notice (the SW is only built for production)
SERWIST_SUPPRESS_TURBOPACK_WARNING=1
